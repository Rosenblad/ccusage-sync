# The SSH host: sshd and rsync, with test/fixtures/machine-b as its Claude Code logs.
FROM debian:stable-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssh-server rsync \
 && rm -rf /var/lib/apt/lists/* && mkdir -p /run/sshd \
 && useradd -m -s /bin/bash me && usermod -p '*' me
COPY id_ed25519.pub /home/me/.ssh/authorized_keys
COPY machine-b/projects /home/me/.claude/projects
RUN chown -R me:me /home/me/.ssh /home/me/.claude && chmod 700 /home/me/.ssh && chmod 600 /home/me/.ssh/authorized_keys
CMD ["/usr/sbin/sshd", "-D", "-e"]
